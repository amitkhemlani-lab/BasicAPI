#!/bin/bash

#############################################################################
# GitHub Copilot Pre-Commit Review Hook
# 
# This hook enforces team standards for code review with GitHub Copilot
# 
# Setup: git config core.hooksPath .githooks
#############################################################################

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="$SCRIPT_DIR/config.json"
REPO_ROOT="$(git rev-parse --show-toplevel)"

#############################################################################
# Load Configuration
#############################################################################

# Default settings
REQUIRE_COPILOT_REVIEW=true
BLOCK_ON_WARNINGS=false
CHECK_SECRETS=true
CHECK_CONSOLE_LOGS=true
CHECK_DEBUGGER=true
CHECK_TODO_FIXME=false
MAX_FILE_SIZE_KB=500
ALLOWED_FILE_PATTERNS="*.cs *.js *.ts *.jsx *.tsx *.py *.java *.go"

# Load from config if exists
if [ -f "$CONFIG_FILE" ]; then
    # Parse JSON (requires jq or use simple grep)
    if command -v jq &> /dev/null; then
        REQUIRE_COPILOT_REVIEW=$(jq -r '.requireCopilotReview // true' "$CONFIG_FILE")
        BLOCK_ON_WARNINGS=$(jq -r '.blockOnWarnings // false' "$CONFIG_FILE")
        CHECK_SECRETS=$(jq -r '.checkSecrets // true' "$CONFIG_FILE")
        CHECK_CONSOLE_LOGS=$(jq -r '.checkConsoleLogs // true' "$CONFIG_FILE")
        CHECK_DEBUGGER=$(jq -r '.checkDebugger // true' "$CONFIG_FILE")
        CHECK_TODO_FIXME=$(jq -r '.checkTodoFixme // false' "$CONFIG_FILE")
        MAX_FILE_SIZE_KB=$(jq -r '.maxFileSizeKB // 500' "$CONFIG_FILE")
    fi
fi

#############################################################################
# Functions
#############################################################################

print_header() {
    echo ""
    echo -e "${CYAN}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}  ${MAGENTA}🤖 GitHub Copilot Pre-Commit Review${NC}                    ${CYAN}║${NC}"
    echo -e "${CYAN}╚════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

print_section() {
    echo ""
    echo -e "${BLUE}▶ $1${NC}"
    echo "─────────────────────────────────────────────────────────────"
}

print_success() {
    echo -e "  ${GREEN}✓${NC} $1"
}

print_warning() {
    echo -e "  ${YELLOW}⚠${NC} $1"
}

print_error() {
    echo -e "  ${RED}✗${NC} $1"
}

print_info() {
    echo -e "  ${BLUE}ℹ${NC} $1"
}

#############################################################################
# Get Staged Files
#############################################################################

get_staged_files() {
    git diff --cached --name-only --diff-filter=ACMR
}

get_staged_code_files() {
    local files=$(get_staged_files)
    local code_files=""
    
    for file in $files; do
        for pattern in $ALLOWED_FILE_PATTERNS; do
            if [[ $file == *"${pattern#\*}"* ]]; then
                code_files="$code_files $file"
                break
            fi
        done
    done
    
    echo "$code_files"
}

#############################################################################
# Check Functions
#############################################################################

check_vscode_available() {
    if command -v code &> /dev/null; then
        return 0
    else
        return 1
    fi
}

check_copilot_extension() {
    if check_vscode_available; then
        if code --list-extensions | grep -q "github.copilot"; then
            return 0
        fi
    fi
    return 1
}

check_file_size() {
    local file=$1
    local size_bytes=$(git cat-file -s ":0:$file" 2>/dev/null || echo 0)
    local size_kb=$((size_bytes / 1024))
    
    if [ $size_kb -gt $MAX_FILE_SIZE_KB ]; then
        return 1
    fi
    return 0
}

check_for_secrets() {
    local files="$1"
    local found=0
    
    for file in $files; do
        # Check for common secret patterns
        if git diff --cached "$file" | grep -qiE "(password|api[_-]?key|secret|token|credentials|private[_-]?key).*=.*['\"][^'\"]{8,}['\"]"; then
            print_error "Potential secret found in: $file"
            found=1
        fi
        
        # Check for AWS keys
        if git diff --cached "$file" | grep -qE "AKIA[0-9A-Z]{16}"; then
            print_error "Potential AWS access key in: $file"
            found=1
        fi
        
        # Check for private keys
        if git diff --cached "$file" | grep -q "BEGIN.*PRIVATE KEY"; then
            print_error "Private key found in: $file"
            found=1
        fi
    done
    
    return $found
}

check_for_console_logs() {
    local files="$1"
    local found=0
    
    for file in $files; do
        if [[ $file =~ \.(js|ts|jsx|tsx)$ ]]; then
            if git diff --cached "$file" | grep -qE "^\+.*console\.(log|debug|info|warn)"; then
                print_warning "console.log found in: $file"
                found=1
            fi
        fi
    done
    
    return $found
}

check_for_debugger() {
    local files="$1"
    local found=0
    
    for file in $files; do
        if git diff --cached "$file" | grep -qE "^\+.*(debugger|Debugger\.Break)"; then
            print_error "Debugger statement found in: $file"
            found=1
        fi
    done
    
    return $found
}

check_for_todo_fixme() {
    local files="$1"
    local found=0
    
    for file in $files; do
        if git diff --cached "$file" | grep -qE "^\+.*(TODO|FIXME|HACK|XXX)"; then
            print_info "TODO/FIXME found in: $file"
            found=1
        fi
    done
    
    return $found
}

check_for_merge_conflicts() {
    local files="$1"
    local found=0
    
    for file in $files; do
        if git diff --cached "$file" | grep -qE "^(\+|-).*(<<<<<<<|=======|>>>>>>>)"; then
            print_error "Merge conflict markers found in: $file"
            found=1
        fi
    done
    
    return $found
}

#############################################################################
# Main Execution
#############################################################################

print_header

# Get staged files
STAGED_FILES=$(get_staged_files)

if [ -z "$STAGED_FILES" ]; then
    print_info "No files staged for commit"
    exit 0
fi

# Display staged files
print_section "Files to be committed"
echo "$STAGED_FILES" | while read file; do
    if [ -f "$file" ]; then
        size=$(git cat-file -s ":0:$file" 2>/dev/null || echo 0)
        size_kb=$((size / 1024))
        echo -e "  ${GREEN}•${NC} $file ${CYAN}(${size_kb}KB)${NC}"
    fi
done

# Get code files
CODE_FILES=$(get_staged_code_files)

if [ -z "$CODE_FILES" ]; then
    print_success "No code files to review"
    exit 0
fi

# Check Copilot availability
print_section "GitHub Copilot Check"
if check_copilot_extension; then
    print_success "GitHub Copilot extension detected"
else
    print_warning "GitHub Copilot extension not found"
    print_info "Install: https://marketplace.visualstudio.com/items?itemName=GitHub.copilot"
fi

# Run automated checks
print_section "Automated Checks"

HAS_ERRORS=0
HAS_WARNINGS=0

# Check file sizes
for file in $CODE_FILES; do
    if ! check_file_size "$file"; then
        print_warning "Large file: $file (>500KB)"
        HAS_WARNINGS=1
    fi
done

# Check for secrets
if [ "$CHECK_SECRETS" = true ]; then
    if check_for_secrets "$CODE_FILES"; then
        print_error "Potential secrets detected!"
        HAS_ERRORS=1
    else
        print_success "No secrets detected"
    fi
fi

# Check for console.log
if [ "$CHECK_CONSOLE_LOGS" = true ]; then
    if check_for_console_logs "$CODE_FILES"; then
        HAS_WARNINGS=1
    else
        print_success "No console.log statements"
    fi
fi

# Check for debugger
if [ "$CHECK_DEBUGGER" = true ]; then
    if check_for_debugger "$CODE_FILES"; then
        HAS_ERRORS=1
    else
        print_success "No debugger statements"
    fi
fi

# Check for merge conflicts
if check_for_merge_conflicts "$CODE_FILES"; then
    HAS_ERRORS=1
    print_error "Merge conflict markers detected!"
else
    print_success "No merge conflicts"
fi

# Check for TODO/FIXME
if [ "$CHECK_TODO_FIXME" = true ]; then
    check_for_todo_fixme "$CODE_FILES"
fi

# Copilot Review Reminder
print_section "GitHub Copilot Review Checklist"
echo ""
echo -e "  ${YELLOW}Before committing, ensure you have:${NC}"
echo ""
echo "  ☐  Reviewed code with Copilot Chat:"
echo -e "     ${CYAN}@workspace /review${NC}"
echo ""
echo "  ☐  Checked for security vulnerabilities"
echo "  ☐  Verified no sensitive data (passwords, API keys)"
echo "  ☐  Ensured proper error handling"
echo "  ☐  Confirmed tests pass"
echo "  ☐  Updated documentation if needed"
echo ""

# Show how to review
print_section "How to Review with Copilot"
echo ""
echo "  1. Open VS Code Copilot Chat (Ctrl+Shift+I or Cmd+Shift+I)"
echo "  2. Type: @workspace /review"
echo "  3. Or ask specific questions:"
echo -e "     ${CYAN}• \"Review my staged changes for security issues\"${NC}"
echo -e "     ${CYAN}• \"Check for performance problems in my changes\"${NC}"
echo -e "     ${CYAN}• \"Are there any bugs in my code?\"${NC}"
echo ""

# Decision point
print_section "Commit Decision"

if [ $HAS_ERRORS -eq 1 ]; then
    echo ""
    echo -e "${RED}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${RED}║  ERRORS DETECTED - COMMIT BLOCKED                          ║${NC}"
    echo -e "${RED}╚════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo "Please fix the errors above before committing."
    echo ""
    echo "To bypass this check (NOT RECOMMENDED):"
    echo "  git commit --no-verify -m \"Your message\""
    echo ""
    exit 1
fi

if [ $HAS_WARNINGS -eq 1 ] && [ "$BLOCK_ON_WARNINGS" = true ]; then
    echo ""
    echo -e "${YELLOW}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${YELLOW}║  WARNINGS DETECTED                                         ║${NC}"
    echo -e "${YELLOW}╚════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    read -p "Continue with commit? (yes/no/review): " -n 1 -r
    echo ""
    
    case $REPLY in
        [Yy]* )
            print_success "Proceeding with commit..."
            ;;
        [Rr]* )
            if check_vscode_available; then
                echo "Opening VS Code for review..."
                code "$REPO_ROOT"
            fi
            echo ""
            print_error "Commit cancelled. Please review and try again."
            exit 1
            ;;
        * )
            print_error "Commit cancelled"
            exit 1
            ;;
    esac
fi

# Success
echo ""
echo -e "${GREEN}╔════════════════════════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║  ✓ PRE-COMMIT CHECKS PASSED                                ║${NC}"
echo -e "${GREEN}╚════════════════════════════════════════════════════════════╝${NC}"
echo ""
echo -e "${CYAN}💡 Tip: Review with Copilot in VS Code for best results!${NC}"
echo ""

exit 0